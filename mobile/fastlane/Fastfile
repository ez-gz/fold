default_platform(:ios)

platform :ios do

  desc "Build and upload to TestFlight"
  # CI sets MATCH_KEYCHAIN_NAME=build.keychain and MATCH_KEYCHAIN_PASSWORD="".
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id:               ENV["ASC_KEY_ID"],
      issuer_id:            ENV["ASC_ISSUER_ID"],
      key_content:          ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house:             false
    )

    match(
      type:              "appstore",
      readonly:          true,
      api_key:           api_key,
      keychain_name:     ENV.fetch("MATCH_KEYCHAIN_NAME", "login.keychain"),
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    # Bump and commit first so the signing edits below never end up in git.
    # No build has ever been uploaded on first run -- that's the only case
    # this should fall back to 0 for; any other failure (auth, rate limit)
    # should fail loudly instead of silently colliding with an existing
    # TestFlight build number.
    current_build = begin
      latest_testflight_build_number(
        api_key:        api_key,
        app_identifier: "com.foldpoker.app"
      )
    rescue => e
      UI.important("latest_testflight_build_number failed (#{e.message}) -- assuming no prior build (0). If a build already exists in TestFlight, stop and investigate instead of re-running.")
      0
    end
    increment_build_number(
      build_number: (current_build.to_i + 1).to_s,
      xcodeproj:    "ios/App/App.xcodeproj"
    )
    commit_version_bump(
      message:   "chore: bump build number [skip ci]",
      xcodeproj: "ios/App/App.xcodeproj",
      force:     true
    )

    update_code_signing_settings(
      path:                  "ios/App/App.xcodeproj",
      targets:               ["App"],
      build_configurations:  ["Release"],
      use_automatic_signing: false,
      team_id:               "JL39GTJ62X",
      code_sign_identity:    "Apple Distribution",
      profile_name:          ENV["sigh_com.foldpoker.app_appstore_profile-name"],
      bundle_identifier:     "com.foldpoker.app"
    )

    gym(
      scheme:           "App",
      workspace:        "ios/App/App.xcworkspace",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "./build_output",
      output_name:      "FoldPoker.ipa",
      clean:            true,
      export_options: {
        method:               "app-store",
        teamID:               "JL39GTJ62X",
        provisioningProfiles: { "com.foldpoker.app" => ENV["sigh_com.foldpoker.app_appstore_profile-name"] },
        signingStyle:         "manual"
      }
    )

    pilot(
      api_key:                           api_key,
      app_identifier:                    "com.foldpoker.app",
      ipa:                               "./build_output/FoldPoker.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("RELEASE_NOTES", "Automated build")
    )

    reset_git_repo(force: true, files: ["ios/App/App.xcodeproj/project.pbxproj"])

    # The build is already uploaded by this point, so a push failure here must
    # not fail the lane -- it would report a red build for an app that
    # actually shipped. Rebase first (someone may have landed a commit while
    # we built), and if the push still fails, say so loudly and carry on:
    # the only thing lost is the build-number bump commit, which the next run
    # recomputes from TestFlight anyway.
    begin
      sh("git pull --rebase origin main")
      push_to_git_remote
    rescue => e
      UI.important("Build shipped, but pushing the version bump failed: #{e.message}")
      UI.important("Not failing the lane -- the next run re-reads the build number from TestFlight.")
    end
  end

  desc "Bootstrap certs (run once, or re-run after adding capabilities)"
  lane :bootstrap_certs do
    api_key = app_store_connect_api_key(
      key_id:               ENV["ASC_KEY_ID"],
      issuer_id:            ENV["ASC_ISSUER_ID"],
      key_content:          ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house:             false
    )

    match(
      type:     "appstore",
      readonly: false,
      force:    true,
      api_key:  api_key
    )
  end

end
